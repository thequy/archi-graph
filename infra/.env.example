# Archi-Graph compose environment. Copy to infra/.env and adjust as needed.
# All values have sensible defaults in docker-compose.yml; this file documents
# every knob and lets you override without editing the compose file.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=archigraph
# Host port the db is published on (container always listens on 5432).
DB_PORT=5433

# ── API DB connection ─────────────────────────────────────────────────────────
# NOTE: uses the compose-internal hostname `db` and its internal port 5432.
DATABASE_URL=postgres://postgres:postgres@db:5432/archigraph

# ── Ollama ──────────────────────────────────────────────────────────────────
# Internal url the api/worker use to reach ollama (compose service name).
OLLAMA_URL=http://ollama:11434
# Host port ollama is published on.
OLLAMA_PORT=11434
EMBED_MODEL=nomic-embed-text
GEN_MODEL=llama3.1

# ── API ───────────────────────────────────────────────────────────────────────
# Host port the api is published on (container listens on 3001).
API_PORT=3001

# ── Worker ────────────────────────────────────────────────────────────────────
# Poll cadence (ms) between embedding-job drains.
WORKER_INTERVAL_MS=5000

# ── Web ───────────────────────────────────────────────────────────────────────
# BUILD-TIME api url baked into the SPA. The browser reaches the api via the
# host-published port, so this is the host url (not the internal `api` name).
VITE_API_URL=http://localhost:3001
# Host port the web app is served on.
WEB_PORT=8080
